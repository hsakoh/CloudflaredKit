<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CloudflaredKit</AssemblyName>
    <RootNamespace>CloudflaredKit</RootNamespace>

    <!-- NuGet package metadata -->
    <PackageId>CloudflaredKit</PackageId>
    <Version>0.1.0</Version>
    <Authors>Hsakoh</Authors>
    <Description>A .NET library that manages the cloudflared binary and Cloudflare Tunnel lifecycle. Supports TryCloudflare (temporary URL, no account required) and permanent tunnel modes.</Description>
    <PackageTags>cloudflare;cloudflared;tunnel;trycloudflare;ngrok</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Hsakoh/CloudflaredKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hsakoh/CloudflaredKit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="/" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
  </ItemGroup>

</Project>
